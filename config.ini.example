; Copy this file to config.ini and fill in the [database] values for your machine.
; config.ini is untracked (.gitignore) because it holds the SQL Server password.
; This template is tracked instead.
;
; config.ini carries ONLY the database connection. Everything hotel-specific -- the
; hotel name, tax rate, lockout, loyalty points rates -- lives in the HotelSettings
; table and is asked for during the first-run wizard (and editable afterwards from
; Admin Panel -> Pricing & Settings).
;
; If config.ini is missing entirely, starting the app prompts for these four values
; and writes the file for you, then the first-run wizard continues in the same run.
; A blank [database] block means no connection at all: get_connection() will yield
; None on every call, and the onboarding wizard cannot run.
[database]
server = localhost
database = hotelSystem
username = admin
password =
